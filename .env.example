# Example configuration — adjust to your environment.

# Path to the SQLite DB **inside the container**. The volume mapping below
# points it at the file on the host.
PAPERLESS_DB=/data/llmindex.db

# Ollama embedding server. From inside a container, localhost is the
# container itself — with Docker Desktop (Windows/macOS) use:
OLLAMA_URL=http://host.docker.internal:11434
# On Linux use the host IP instead, e.g.:
# OLLAMA_URL=http://172.17.0.1:11434
# and set OLLAMA_HOST=0.0.0.0 for Ollama on the host.

# Embedding model (must match the one the index was built with!)
EMBED_MODEL=embeddinggemma:latest

# Optional prefix for query embeddings (leave empty for raw).
QUERY_PREFIX=

# Seconds to wait if the DB is locked by a writer.
DB_TIMEOUT=5.0

# API key for the HTTP endpoint — REQUIRED (server refuses to start without).
# Generate one: openssl rand -hex 32
# Clients send it as: Authorization: Bearer <key>   (or X-API-Key: <key>)
MCP_API_KEY=change-me

# Transport: streamable-http (default), sse or stdio
MCP_TRANSPORT=streamable-http
MCP_HOST=0.0.0.0
MCP_PORT=8000
